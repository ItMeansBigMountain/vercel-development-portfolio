{
  "name": "@journal-ai/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web --output-dir dist/web",
    "build:ios": "expo export --platform ios --output-dir dist/ios",
    "build:android": "expo export --platform android --output-dir dist/android"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~57.0.18",
    "expo-asset": "~57.0.13",
    "expo-audio": "^57.0.4",
    "expo-constants": "^57.0.2",
    "expo-document-picker": "^57.0.1",
    "expo-linking": "~57.0.8",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-web-browser": "^57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "^19",
    "typescript": "~6.0.3"
  }
}
