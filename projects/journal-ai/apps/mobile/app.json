{
  "expo": {
    "name": "Journal AI",
    "slug": "journal-ai",
    "scheme": "journalai",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false,
          "faceIDPermission": "Allow Journal AI to protect your private journal."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "reflections"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Journal AI to record a meeting after everyone has consented."
        }
      ],
      "expo-asset"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.journalai.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.journalai.app",
      "permissions": [
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}
