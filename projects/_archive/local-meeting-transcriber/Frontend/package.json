    "expo-constants": "^56.0.17",
    "expo-file-system": "^56.0.7",
    "expo-secure-store": "^56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "^4.25.2",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.2.3",
    "expo-doctor": "^1.19.9",
    "typescript": "~6.0.3"
