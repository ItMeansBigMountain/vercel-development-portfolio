# Keep the backup repo from accidentally publishing local secrets or volatile runtime files.
# The .hermes/ directory itself is intentionally tracked as a sanitized backup.

# Secrets / credentials
.env
.env.*
!.env.example
!.env.*.template
.git-credentials
.netrc
**/.env
**/.env.*
!**/.env.example
!**/.env.*.template
**/*secret*
**/*token*
**/*credential*
**/*service_account*.json
**/google_service_account.json
**/cred.json
**/auth.json
**/auth.lock
**/auth-*.json
**/oauth*.json
**/keyring*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa*
**/id_ed25519*

# Runtime locks / pids / sockets
*.lock
*.pid
*.sock
*.log
**/.tick.lock
/projects/KANBAN_SWEEP_DISPATCH.log

